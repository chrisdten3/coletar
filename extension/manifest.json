{
  "manifest_version": 3,
  "name": "coleta \u2014 portable memory",
  "version": "0.3.1",
  "description": "Opt-in automatic recall on Send, with encrypted capture of your prompt and the completed reply on the active page.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "coleta \u2014 open settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "bridge-core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
