# --- Tenancy ---------------------------------------------------------------
# Resolved by *application boundaries* only: the CLI (overridable with --tenant)
# and the local proxy. The MCP server never reads this — it derives the tenant
# from the authenticated principal, because a connector that falls back to a
# configured tenant is a connector serving someone else's graph.
COLETAR_DEFAULT_TENANT_ID=tenant_local

# --- Canonical store -------------------------------------------------------
# "memory" runs the entire stack with no infrastructure — this is the default so a
# fresh clone works before `docker compose up`. Switch to "postgres" for the real
# backend: `docker compose up -d && uv run coletar migrate`.
COLETAR_STORE_BACKEND=memory
COLETAR_DATABASE_URL=postgresql://coletar:coletar@localhost:5433/coletar
# Where the Postgres integration tests look for a database. They skip, rather than
# fail, when nothing is listening.
COLETAR_TEST_DATABASE_URL=postgresql://coletar:coletar@localhost:5433/coletar

# --- Local proxy daemon (§4, §10 step 1) -----------------------------------
# Upstream OpenAI-compatible endpoint. Ollama: http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1 ; vLLM: http://localhost:8000/v1
COLETAR_UPSTREAM_BASE_URL=http://localhost:11434/v1
COLETAR_UPSTREAM_API_KEY=
COLETAR_PROXY_PORT=8787

# --- Hosted MCP server (§9) ------------------------------------------------
COLETAR_MCP_PORT=8788
# Public hostnames this service answers on, comma-separated. Empty means the SDK's
# localhost-only default — right locally, and refused with 421 once served from a
# real domain.
COLETAR_MCP_ALLOWED_HOSTS=
# Bearer keys as a JSON array. Each key names its tenant: that is the only thing
# deciding which graph the caller reaches. `scopes` defaults to ["read","write"].
# Empty means the server refuses to start — it never serves unauthenticated.
# COLETAR_MCP_API_KEYS=

# M4.2: point the local proxy at the MCP server instead of the database. Leave
# both unset and the proxy uses the in-process store directly, which is what
# makes the wedge work with no infrastructure. Set them and the daemon holds an
# API key instead of database credentials, and its reads and writes go through
# the same auth, tenancy and scope checks as every other connector.
# COLETAR_MCP_URL=http://localhost:8788/mcp
COLETAR_MCP_URL=
COLETAR_MCP_API_KEY='[{"id":"alice-claude","secret":"sk-live-...","tenant_id":"tenant_alice"}]'
COLETAR_MCP_API_KEYS=

# --- Retrieval -------------------------------------------------------------
# "hashing" needs nothing installed and is the default, so a fresh clone has a
# working vector index immediately; it reaches morphological variants but not
# synonymy. "ollama" is the real embedder, running against your own model server
# where inference is free — `ollama pull nomic-embed-text` first.
COLETAR_EMBEDDING_BACKEND=hashing
COLETAR_EMBEDDING_MODEL=nomic-embed-text
COLETAR_EMBEDDING_DIM=768
COLETAR_RETRIEVAL_TOKEN_BUDGET=1500

# --- Extraction -----------------------------------------------------------
# The provider choice is also a data-routing choice: Ollama stays local; Anthropic
# and OpenAI send only the candidate turn to that named subprocessor.
COLETAR_EXTRACTION_MODE=heuristic
COLETAR_EXTRACTION_PROVIDER=ollama
COLETAR_OLLAMA_EXTRACTION_MODEL=llama3.1
COLETAR_ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5
COLETAR_OPENAI_EXTRACTION_MODEL=gpt-5.6-terra

# Raw-turn capture is deliberately opt-in. With collect_then_batch the request
# stores an encrypted EPISODE and returns; run `coletar extract-pending` out of band.
COLETAR_CAPTURE_TURNS=false
COLETAR_LIVE_EXTRACTION_MODE=off
COLETAR_CAPTURE_TTL_DAYS=30
COLETAR_EXTRACTION_BATCH_SIZE=100

# Snapshot file for the zero-infrastructure store backend.
COLETAR_STORE_PATH=data/coletar.json

# --- Deployment target ------------------------------------------------------
# Where `fly secrets set COLETAR_DATABASE_URL=...` gets its value. Use a session
# pooler or a direct connection — never a transaction pooler, since psycopg3
# auto-prepares statements and transaction pooling cannot serve them.
# The test suite needs a *direct* Postgres instead: it creates and drops a
# database per test, which pooled connections prevent.
COLETAR_DEPLOY_DATABASE_URL=
