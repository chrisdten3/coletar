# --- Tenancy ---------------------------------------------------------------
# Resolved by *application boundaries* only: the CLI (overridable with --tenant)
# and the local proxy. The MCP server never reads this — it derives the tenant
# from the authenticated principal, because a connector that falls back to a
# configured tenant is a connector serving someone else's graph.
COLETAR_DEFAULT_TENANT_ID=tenant_local

# --- Canonical store -------------------------------------------------------
# "memory" runs the entire stack with no infrastructure — this is the default so a
# fresh clone works before `docker compose up`. Switch to "postgres" for the real
# backend: `docker compose up -d && uv run coletar migrate`.
COLETAR_STORE_BACKEND=memory
COLETAR_DATABASE_URL=postgresql://coletar:coletar@localhost:5433/coletar
# Where the Postgres integration tests look for a database. They skip, rather than
# fail, when nothing is listening.
COLETAR_TEST_DATABASE_URL=postgresql://coletar:coletar@localhost:5433/coletar

# --- Local proxy daemon (§4, §10 step 1) -----------------------------------
# Upstream OpenAI-compatible endpoint. Ollama: http://localhost:11434/v1
# LM Studio: http://localhost:1234/v1 ; vLLM: http://localhost:8000/v1
COLETAR_UPSTREAM_BASE_URL=http://localhost:11434/v1
COLETAR_UPSTREAM_API_KEY=
COLETAR_PROXY_PORT=8787

# --- Hosted MCP server (§9) ------------------------------------------------
COLETAR_MCP_PORT=8788
# Public hostnames this service answers on, comma-separated. Empty means the SDK's
# localhost-only default — right locally, and refused with 421 once served from a
# real domain.
COLETAR_MCP_ALLOWED_HOSTS=
# Bearer keys as a JSON array. Each key names its tenant: that is the only thing
# deciding which graph the caller reaches. `scopes` defaults to ["read","write"].
# Empty means the server refuses to start — it never serves unauthenticated.
# COLETAR_MCP_API_KEYS=

# M4.2: point the local proxy at the MCP server instead of the database. Leave
# both unset and the proxy uses the in-process store directly, which is what
# makes the wedge work with no infrastructure. Set them and the daemon holds an
# API key instead of database credentials, and its reads and writes go through
# the same auth, tenancy and scope checks as every other connector.
# COLETAR_MCP_URL=http://localhost:8788/mcp
COLETAR_MCP_URL=
COLETAR_MCP_API_KEY='[{"id":"alice-claude","secret":"sk-live-...","tenant_id":"tenant_alice"}]'
COLETAR_MCP_API_KEYS=

# --- Retrieval -------------------------------------------------------------
# "hashing" needs nothing installed and is the default, so a fresh clone has a
# working vector index immediately; it reaches morphological variants but not
# synonymy. "ollama" is the real embedder, running against your own model server
# where inference is free — `ollama pull nomic-embed-text` first.
COLETAR_EMBEDDING_BACKEND=hashing
COLETAR_EMBEDDING_MODEL=nomic-embed-text
COLETAR_EMBEDDING_DIM=768
COLETAR_RETRIEVAL_TOKEN_BUDGET=1500

# --- Extraction -----------------------------------------------------------
# The provider choice is also a data-routing choice: Ollama stays local; Anthropic
# and OpenAI send only the candidate turn to that named subprocessor.
COLETAR_EXTRACTION_MODE=heuristic
COLETAR_EXTRACTION_PROVIDER=ollama
COLETAR_OLLAMA_EXTRACTION_MODEL=llama3.1
COLETAR_ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5
COLETAR_OPENAI_EXTRACTION_MODEL=gpt-5.6-terra

# Raw-turn capture is deliberately opt-in. With collect_then_batch the request
# stores an encrypted EPISODE and returns; run `coletar extract-pending` out of band.
COLETAR_CAPTURE_TURNS=false
COLETAR_LIVE_EXTRACTION_MODE=off
COLETAR_CAPTURE_TTL_DAYS=30
COLETAR_EXTRACTION_BATCH_SIZE=100

# Snapshot file for the zero-infrastructure store backend.
COLETAR_STORE_PATH=data/coletar.json

# --- Deployment target ------------------------------------------------------
# Source for the hosted COLETAR_DATABASE_URL secret. The Store disables prepared
# statements for Supabase pooler compatibility. Use a direct/session connection
# for schema migrations.
# The test suite needs a *direct* Postgres instead: it creates and drops a
# database per test, which pooled connections prevent.
COLETAR_DEPLOY_DATABASE_URL=

# Hosted workspace. Setting this marks the deployment hosted, which *refuses* the
# local identity provider: a hosted workspace cannot run on laptop auth by nobody
# changing a setting.
COLETAR_PUBLIC_URL=

# --- Accounts and sign-in ---------------------------------------------------
# Which provider vouches for a person. "local" trusts whoever can reach the port
# and is refused whenever COLETAR_PUBLIC_URL is set. "supabase" is what the hosted
# deployment runs; "clerk" is still implemented and switchable with this one value.
COLETAR_IDENTITY_PROVIDER=local

# --- Supabase Auth ----------------------------------------------------------
# The project URL, e.g. https://your-ref.supabase.co. The issuer that is checked
# and the JWKS that is trusted are BOTH derived from this, so a partial edit here
# cannot end up verifying one project's tokens against another project's keys.
COLETAR_SUPABASE_URL=
# Only to override the derived {url}/auth/v1/.well-known/jwks.json.
COLETAR_SUPABASE_JWKS_URL=
# The anon key. Publishable, and it belongs in the browser bundle — it is what the
# client presents to reach the auth endpoints. It grants nothing on its own:
# migrations 008 and 012 enable RLS with no client policies, so it reaches no
# coletar table at all.
COLETAR_SUPABASE_ANON_KEY=
#
# The *service role* key is deliberately not a setting and must never be added as
# one. It bypasses RLS and can mint a session for any user, and no request path in
# coletar needs it, because verifying a session is a signature check against a
# public JWKS. Only scripts/provision_demo.py reads one, from the environment, on
# the machine of whoever runs it -- never from here and never on the server.
#
# Supabase must be on asymmetric JWT signing keys (dashboard → Authentication →
# JWT Keys). The legacy HS256 arrangement signs with a shared secret, and a secret
# that verifies a token can also forge one; accounts/supabase.py refuses it.

# --- Clerk ------------------------------------------------------------------
# Only needed when COLETAR_IDENTITY_PROVIDER=clerk. Kept alongside Supabase rather
# than deleted: the provider is one setting, and a deployment must be able to move
# between them without a code change.
# From Clerk's API Keys screen, e.g. https://your-app.clerk.accounts.dev. This is
# the `iss` on every session token and the root of the JWKS URL.
COLETAR_CLERK_ISSUER=
# Only to override the derived {issuer}/.well-known/jwks.json.
COLETAR_CLERK_JWKS_URL=
# Origins allowed to present a Clerk token here, comma-separated. Empty is refused
# rather than read as "any": a token minted for another site on the same Clerk
# instance must not be spendable here.
COLETAR_CLERK_AUTHORIZED_PARTIES=
# Publishable and genuinely safe in the browser bundle. coletar reads no Clerk
# secret key anywhere — verification is a signature check against a public JWKS.
COLETAR_CLERK_PUBLISHABLE_KEY=

# Invite-gated beta. Comma-separated addresses that may provision a *new* account.
# An empty list means closed, not open. This gates provisioning only, so removing
# an address never locks its owner out of the graph they already have.
COLETAR_INVITE_ALLOWLIST=
# The explicit switch from invite-only to public signup. Deliberately its own
# setting rather than "leave the allowlist empty".
COLETAR_OPEN_REGISTRATION=false
# Vercel sends this as a bearer credential to its scheduled capture endpoint.
CRON_SECRET=
