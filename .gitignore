# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Env & secrets
.env
.env.*
!.env.example

# Local data
data/
*.db
*.sqlite3

# Provider exports — never commit anyone's AI history
exports/
*.zip
conversations.json

# OS / editor
.DS_Store
.idea/
.vscode/

# ...but the importer tests need a synthetic export to parse, and the rules above
# would swallow it. These two are generated fixtures — "Conversation 0",
# someone@example.com — not anyone's history. conftest.py zips them at session
# start; the archive itself is still never committed.
!tests/fixtures/export_sources/*/conversations.json
